{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run build)",
      "Bash(npm run serve)",
      "Bash(npm run clear)",
      "Bash(npm start)",
      "Bash(npm run check)",
      "Bash(python scripts/check_docs.py:*)",
      "Bash(python scripts/build_nav.py:*)",
      "Bash(python scripts/add_frontmatter.py:*)",
      "Bash(python scripts/normalize_headings.py:*)",
      "Bash(python scripts/check_fuentes.py:*)",
      "Bash(python scripts/check_codabench.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./scripts/privados.txt)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validar_doc.py\""
          }
        ]
      }
    ]
  }
}
